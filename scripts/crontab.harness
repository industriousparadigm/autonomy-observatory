TZ=Europe/Lisbon
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# One line, forever. Which arms exist, how often each wakes, and whether any of
# them is paused are decisions, not deploys — they live in each arm's control
# file on the volume and are read by `cli.ts due` on every tick. See
# scripts/tick.sh and src/control.ts.
#
# Before this, every arm had its own line here with its own cron expression,
# which meant the observatory could show the schedule and never change it, and
# adding an arm meant rebuilding the image.
#
# Runs as root so run-arm.sh can log to the container's captured stdout before
# dropping to the unprivileged `agent` user — see run-arm.sh.
* * * * * root /app/scripts/tick.sh >>/proc/1/fd/1 2>>/proc/1/fd/2
