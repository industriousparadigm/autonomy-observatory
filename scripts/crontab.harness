TZ=Europe/Lisbon
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Deliberately irregular: 06:17, 12:17, 18:17, 23:17 Europe/Lisbon, DST-aware.
# Evenly spaced wake times would flatten a variable the experiment measures.
# Runs as root so run-arm.sh can log to the container's captured stdout
# before dropping to the unprivileged `agent` user — see run-arm.sh.
17 6,12,18,23 * * * root /app/scripts/run-arm.sh a >>/proc/1/fd/1 2>>/proc/1/fd/2
